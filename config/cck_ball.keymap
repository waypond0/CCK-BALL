#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

   behaviors {
    click_or_key: click_or_key {
        // ↑ 이 behavior의 "이름"을 짓는 줄이에요.
        //   click_or_key라는 이름표를 붙여서, 나중에 이 이름으로 불러 쓸 수 있게 등록하는 거예요.
        //   (사람으로 치면 "이 조합에 별명을 지어준다"는 느낌)

        compatible = "zmk,behavior-hold-tap";
        // ↑ "이건 hold-tap 종류의 behavior다"라고 ZMK에게 알려주는 줄이에요.
        //   즉 "짧게 누르면 A, 길게 누르면 B" 같은 동작을 만들겠다는 선언이에요.

        #binding-cells = <2>;
        // ↑ 이 behavior를 실제로 쓸 때 파라미터(빈칸)가 2개 필요하다는 뜻이에요.
        //   예: &click_or_key [빈칸1] [빈칸2] ← 이렇게 두 개를 채워야 완성돼요.

        tapping-term-ms = <200>;
        // ↑ "몇 밀리초(ms) 안에 손을 떼면 짧게 누른 걸로 칠지"를 정하는 시간이에요.
        //   200ms(0.2초) 안에 떼면 "탭"으로, 그보다 오래 누르면 "홀드"로 판정해요.

        flavor = "tap-preferred";
        // ↑ 판정 방식을 정하는 옵션이에요. "tap-preferred"는
        //   "애매하면 무조건 짧게 누른 걸로(탭으로) 우선 처리해라"는 뜻이에요.
        //   S, D처럼 타이핑에 자주 쓰는 키라, 실수로 클릭 나가는 걸 최대한 막기 위한 안전장치예요.

        bindings = <&mkp>, <&kp>;
        // ↑ 여기가 핵심이에요. "홀드했을 때는 &mkp(마우스 클릭)를,
        //   탭했을 때는 &kp(일반 키보드 키)를 실행해라"는 뜻이에요.
        //   순서가 중요해요 — 앞에 있는 게 홀드용, 뒤에 있는 게 탭용이에요.

        hold-while-undecided;
        // ↑ "판정이 끝나기 전이라도(200ms 다 채우기 전이라도), 일단 누르자마자
        //   바로 클릭을 걸어달라"는 옵션이에요. 마우스 클릭 반응 속도를 빠르게 해줘요.
        //   만약 나중에 짧게 뗀 걸로 판정되면, 걸었던 클릭은 취소되고 원래 키(S나 D)가 나가요.
    };
};

    macros {
        gyeom_open: gyeom_open {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SEMI &kp SEMI &kp G &kp L &kp ENTER &kp LEFT>;
            label = "GYEOM_OPEN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp ESC         &kp N1        &kp N2        &kp N3     &kp N4     &kp N5  &kp N6  &kp N7     &kp N8     &kp N9          &kp N0          &kp BACKSPACE
&kp TAB         &kp Q         &kp W         &kp E      &kp R      &kp T   &kp Y   &kp U      &kp I      &kp O           &kp P           &kp BACKSPACE
&kp CAPSLOCK    &kp A         &click_or_key LCLK S         &click_or_key RCLK D      &kp F      &kp G   &kp H   &kp J      &kp K      &kp L           &kp SEMI        &kp SQT
&kp LEFT_SHIFT  &kp Z         &kp X         &kp C      &kp V      &kp B   &kp N   &kp M      &kp COMMA  &kp DOT         &kp UP_ARROW    &kp RIGHT_SHIFT
&kp LCTRL       &kp LEFT_WIN  &kp LEFT_ALT  &kp ENTER  &kp ENTER  &mo 2   &mo 1   &kp SPACE  &kp SPACE  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings =
                <&inc_dec_kp LA(LEFT) LA(RIGHT)>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        F_layers {
            bindings = <
&kp F12  &kp F1       &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&none    &gyeom_open  &none   &none   &none   &trans  &none   &none   &none   &trans  &trans   &trans
&trans   &none        &none   &none   &none   &trans  &none   &none   &trans  &trans  &trans   &trans
&trans   &trans       &trans  &trans  &trans  &none   &none   &none   &trans  &trans  &none    &trans
&trans   &trans       &trans  &trans  &trans  &trans  &none   &none   &trans  &trans  &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        BT_layers {
            bindings = <
&bootloader  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bootloader  &trans  &trans  &trans  &trans  &kp W
&trans       &trans          &trans        &trans        &trans        &trans        &trans       &trans  &trans  &trans  &trans  &trans
&trans       &bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &bootloader  &trans  &trans  &trans  &trans  &trans
&trans       &trans          &trans        &bt BT_CLR    &trans        &trans        &bt BT_NXT   &trans  &trans  &trans  &trans  &trans
&trans       &trans          &trans        &trans        &trans        &trans        &trans       &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                // 编码器1：上下滚动,,,,,,,,,,,,,,,,
                <&scroll_horizontal_encoder>;

            // 编码器2：左右滚动
        };

        layer_5 {
            bindings = <
&trans  &trans    &trans     &trans     &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans    &trans     &trans     &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &mkp MB4  &mkp LCLK  &mkp RCLK  &mkp MB5  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans    &trans     &trans     &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans    &trans     &trans     &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
